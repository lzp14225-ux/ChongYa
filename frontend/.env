# 当前环境：dev=本地开发
VITE_APP_ENV=dev

# 后端 API 服务端口：8000，用于瑞利杰内部端、供应商端、仓库端统一访问后端接口
VITE_API_BASE_URL=http://localhost:8000/api/v1

# React Web 前端开发服务端口：3002，用于瑞利杰内部端 PC、供应商端 PC、仓库 Web/H5 备用端
VITE_DEV_SERVER_PORT=3002

# 瑞利杰内部端 PC 路由前缀
VITE_APP_RUILIJIE_BASE=/ruilijie

# 供应商端 PC 路由前缀
VITE_APP_SUPPLIER_BASE=/supplier

# 仓库端 Web/H5 备用路由前缀，微信小程序不使用该端口配置
VITE_APP_WAREHOUSE_BASE=/warehouse

# 是否启用前端 Mock 数据
VITE_ENABLE_MOCK=false

# 是否启用前端智能助手入口
VITE_ENABLE_AGENT_ASSISTANT=true
