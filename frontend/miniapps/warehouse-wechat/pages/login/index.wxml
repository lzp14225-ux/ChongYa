<view class="page">
  <view class="card">
    <view class="card-title">仓库作业端{{mode === 'login' ? '登录' : '注册'}}</view>
    <view class="grid" style="grid-template-columns: repeat(2, 1fr);">
      <button class="button" data-mode="login" bindtap="switchMode">登录</button>
      <button class="button" data-mode="register" bindtap="switchMode">注册</button>
    </view>
    <input placeholder="手机号" data-field="phone" value="{{phone}}" bindinput="updateField" />
    <input wx:if="{{mode === 'register'}}" placeholder="用户名" data-field="username" value="{{username}}" bindinput="updateField" />
    <input password placeholder="密码" data-field="password" value="{{password}}" bindinput="updateField" />
    <button class="button" bindtap="submit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
  </view>
</view>
