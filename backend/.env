APP_NAME=ruilijie-supply-chain-platform
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL 数据库配置
POSTGRES_HOST=192.168.3.67
POSTGRES_PORT=5432
POSTGRES_DB=gyl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql+asyncpg://postgres:root@192.168.3.67:5432/gyl

# 瑞利杰内部端登录 JWT 配置
JWT_SECRET_KEY=dev-ruilijie-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 日志配置
LOG_DIR=logs
LOG_LEVEL=INFO
LOGIN_LOG_FILE=auth-login.log
ERROR_LOG_FILE=error.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

CORS_ORIGINS=http://localhost:3002
